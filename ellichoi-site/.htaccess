# ellichoi.com (eigener All-Inkl-Account) - wird vom Workflow deploy-ellichoi.yml hochgeladen
Options -MultiViews
DirectoryIndex index.html

# HTML-Seiten immer neu pruefen lassen, damit Aenderungen sofort sichtbar sind
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Die Seite hiess auf tvmartists.com elli-choi.html - auf der eigenen Domain ist sie die Startseite
RedirectMatch 301 ^/elli-choi\.html$ /
