# Mats-Thiersch-Seite (eigener All-Inkl-Unteraccount) - wird vom Workflow deploy-thiersch.yml als .htaccess hochgeladen
Options -MultiViews
DirectoryIndex index.html

# Immer https und immer die Adresse ohne www (301). Zwei Bedingungen gegen Weiterleitungsschleifen: der Server sitzt hinter einem Proxy,
# deshalb gilt eine Anfrage auch dann als https, wenn der Proxy es per X-Forwarded-Proto meldet.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://matsthiersch.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.matsthiersch\.com$ [NC]
  RewriteRule ^ https://matsthiersch.com%{REQUEST_URI} [L,R=301]
</IfModule>

# HTML-Seiten immer neu pruefen lassen, damit Aenderungen sofort sichtbar sind
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
